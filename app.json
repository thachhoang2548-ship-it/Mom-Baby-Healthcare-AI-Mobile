{
  "expo": {
    "name": "Mom Oi - Healthcare AI",
    "slug": "mom-oi-healthcare-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#FDF2F8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momoi.healthcare"
    },
    "android": {
      "package": "com.momoi.healthcare",
      "adaptiveIcon": {
        "backgroundColor": "#FDF2F8",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ung dung can quyen truy cap anh de chan doan trieu chung AI.",
          "cameraPermission": "Ung dung can quyen mo camera de chup anh trieu chung AI."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
